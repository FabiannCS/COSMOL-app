# ==============================================================================
# VARIABLES DE ENTORNO — COSMOL R.L. (Desarrollo Local y Staging)
# ==============================================================================

# --- ENTORNO Y SEGURIDAD ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=cosmol_dev_secret_key_change_in_production_3849102834
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_SERVER=db-postgres
POSTGRES_PORT=5432
POSTGRES_USER=cosmol_user
POSTGRES_PASSWORD=cosmol_secret_pass
POSTGRES_DB=cosmol_db

# URL para el contenedor FastAPI interno (red Docker)
DATABASE_URL=postgresql+asyncpg://cosmol_user:cosmol_secret_pass@db-postgres:5432/cosmol_db
# URL para herramientas directas en localhost (DBeaver, TablePlus, Alembic local)
LOCAL_DATABASE_URL=postgresql+asyncpg://cosmol_user:cosmol_secret_pass@localhost:5432/cosmol_db

# --- CACHÉ Y RATE LIMITING (REDIS) ---
REDIS_HOST=cache-redis
REDIS_PORT=6379
REDIS_URL=redis://cache-redis:6379/0
LOCAL_REDIS_URL=redis://localhost:6379/0

# --- ALMACENAMIENTO DE DOCUMENTOS (MINIO S3) ---
MINIO_ENDPOINT=storage-minio:9000
MINIO_ROOT_USER=cosmol_minio_admin
MINIO_ROOT_PASSWORD=cosmol_minio_secret_pass
MINIO_BUCKET_NAME=cosmol-docs

# --- GATEWAY / PROXY CADDY (PUERTO 443 ESTÁNDAR CON SSL) ---
# En producción, Caddy enruta https://chatbot.cosmol.com.bo/api/v1 -> host.docker.internal:8000
APP_DOMAIN=chatbot.cosmol.com.bo
APP_EXTERNAL_PORT=443

# --- MENSAJERÍA Y OTP (WHATSAPP CLOUD API & SMS) ---
# En desarrollo local: MOCK_MESSAGING=true (los OTP se muestran en logs y en debug_codigo_otp)
# Para demo en vivo ante los jefes: poner MOCK_MESSAGING=false y copiar el WHATSAPP_TOKEN de Cosmol-Chatbot
MOCK_MESSAGING=true
OTP_EXPIRE_SECONDS=300
OTP_MAX_REQUESTS_PER_HOUR=3
OTP_CODE_LENGTH=6

# Meta WhatsApp Cloud API (Reutiliza la WABA y número de COSMOL R.L.)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=codigo_autenticacion_cosmol

# Gateway SMS (Respaldo nacional)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# --- AUDITORÍA ASÍNCRONA A COSMOL-REPORTES ---
# URL y token del sistema de reportes institucional de COSMOL (Dejar vacío para omitir en desarrollo local)
REPORTES_API_URL=
REPORTES_API_TOKEN=
REPORTES_ID_USUARIO_APP=3
REPORTES_TIMEOUT_SECONDS=3.0
REPORTES_ENABLED=true

# --- INTEGRACIÓN SISTEMA LEGADO (COSMOL COMERCIAL) ---
COSMOL_LEGACY_URL=http://api.cosmol.com.bo/api-consultas
COSMOL_LEGACY_TIMEOUT_SECONDS=4.0
MOCK_COSMOL_LEGACY=false
DEBT_CACHE_TTL_SECONDS=600
