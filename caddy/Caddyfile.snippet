# ==============================================================================
# CADDY PROXY SNIPPET — COSMOL R.L. (ETAPA FINAL / DESPLIEGUE STAGING)
# ==============================================================================
# NOTA IMPORTANTE PARA EL ENCARGADO / SYSADMIN:
# En desarrollo local este servicio NO se levanta (el frontend y tests van directo a :8000).
# Para habilitar el acceso público en el servidor durante la demo ante los jefes:
#
# Copiar este bloque dentro del Caddyfile central del servidor (ej. en D:\Cosmol-Chatbot\Caddyfile):
# ==============================================================================

# {$DOMAIN_NAME:chatbot.cosmol.com.bo}:8083 {
#     # 1. Reverse proxy hacia la API de la App de Socios
#     handle /api/* {
#         reverse_proxy host.docker.internal:8000
#     }
# 
#     # 2. Documentación interactiva de Swagger UI / OpenAPI
#     handle /docs* {
#         reverse_proxy host.docker.internal:8000
#     }
#     handle /openapi.json {
#         reverse_proxy host.docker.internal:8000
#     }
# 
#     # 3. Respuesta base de verificación del Gateway
#     handle {
#         respond "COSMOL App de Socios API - Operativa en Puerto 8083 con SSL" 200
#     }
# }

