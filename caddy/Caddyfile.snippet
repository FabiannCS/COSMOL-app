# ==============================================================================
# CADDY PROXY SNIPPET — COSMOL R.L. (ETAPA FINAL / DESPLIEGUE)
# ==============================================================================
# NOTA IMPORTANTE:
# Este servicio y archivo se encuentran COMENTADOS E INACTIVOS en este repositorio.
# No se levanta ningún contenedor Caddy aquí durante la etapa de desarrollo.
#
# En la etapa final, dependiendo de la arquitectura de servidores:
#
# OPCIÓN A (Compartido con Cosmol-Chatbot y Reportes):
#   - Se copia la regla de abajo en el Caddyfile central del servidor (ej. en Cosmol-Chatbot)
#     enrutando al puerto 90 o mediante upstream de Docker.
#
# OPCIÓN B (Servidor Aislado/Independiente para la App de Socios):
#   - Se descomenta el servicio `gateway-caddy` en `docker-compose.yml`.
#   - Se descomentan las directivas de este archivo.
# ==============================================================================

# {
#     # En desarrollo local y puertos específicos desactivamos auto_https
#     auto_https off
# }
# 
# # Escucha en puerto 80 interno (mapeado al puerto 90 en el host/servidor)
# :80, :90, {$APP_DOMAIN:localhost}:90 {
#     # 1. Reverse proxy hacia FastAPI
#     handle /api/* {
#         reverse_proxy backend-api:8000
#     }
# 
#     # 2. Documentación interactiva de Swagger / OpenAPI
#     handle /docs* {
#         reverse_proxy backend-api:8000
#     }
#     handle /openapi.json {
#         reverse_proxy backend-api:8000
#     }
# 
#     # 3. Respuesta base de verificación del Gateway
#     handle {
#         respond "COSMOL App Gateway (Caddy) - Operativo en Puerto 90" 200
#     }
# }
